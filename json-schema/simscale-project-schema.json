{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/simscale/main/json-schema/simscale-project-schema.json",
  "title": "SimScale Project",
  "description": "Schema for a SimScale simulation project resource.",
  "type": "object",
  "properties": {
    "projectId": {"type": "string", "description": "Unique project identifier."},
    "name": {"type": "string", "description": "Project name."},
    "description": {"type": "string", "description": "Project description."},
    "measurementSystem": {"type": "string", "enum": ["SI", "US"], "description": "Unit system."},
    "created": {"type": "string", "format": "date-time"},
    "modified": {"type": "string", "format": "date-time"},
    "geometryCount": {"type": "integer", "minimum": 0},
    "simulationCount": {"type": "integer", "minimum": 0}
  },
  "required": ["projectId", "name"]
}
